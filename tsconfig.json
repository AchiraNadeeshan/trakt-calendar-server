{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "lib": [
      "ES2021"
    ],
    "strict": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "api"
  ]
}
